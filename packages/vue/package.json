{
  "name": "@openvue/openicons-vue",
  "version": "1.0.0-beta.0",
  "description": "Tree-shakeable Vue 3 SVG components for OpenIcons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openvi-foundation/openicons.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "icons",
    "svg",
    "vue",
    "vue3",
    "openvue",
    "openvi"
  ],
  "author": "OpenVi Foundation",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./icons/*": {
      "types": "./icons/*.d.ts",
      "default": "./icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "icons",
    "index.js",
    "index.d.ts",
    "runtime.js",
    "runtime.d.ts"
  ],
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
