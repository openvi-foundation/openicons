{
  "name": "@openvue/openicons",
  "version": "1.0.0",
  "description": "Icon library for OpenVue and other OpenVi Foundation projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openvi-foundation/openicons.git"
  },
  "keywords": [
    "icons",
    "icon-font",
    "openvue",
    "openvi"
  ],
  "author": "OpenVi Foundation",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/openvi-foundation/openicons/issues"
  },
  "homepage": "https://github.com/openvi-foundation/openicons#readme",
  "files": [
    "fonts",
    "raw-svg",
    "openicons.css",
    "openicons-compat.css",
    "primeicons.css",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm build:font && pnpm build:compat && pnpm build:vue",
    "build:font": "node scripts/build-font.mjs",
    "build:compat": "node scripts/build-compat.mjs",
    "build:vue": "node scripts/build-vue.mjs",
    "normalize": "node scripts/normalize-svg.mjs",
    "check": "node scripts/normalize-svg.mjs --check",
    "check:codepoints": "node scripts/check-codepoints.mjs",
    "add-icon": "node scripts/add-icon.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.40",
    "esbuild": "^0.28.1",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "svgo": "^4.0.2",
    "svgpath": "^2.6.0",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.40"
  }
}
